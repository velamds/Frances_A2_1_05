 [{"content": "frn4le05ob08re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " \u00c9crivez le carnet de voyage d'une autre personne.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "Writing", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Consignes : Compl\u00e9tez les \u00e9tapes suivantes. Remplissez la grille d'auto-\u00e9valuation. ", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "id": 1, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "frn4le05ob08re2aud01", "coverimg": "frn4le05ob08re2img01.jpg", "images": [{"image": "frn4le05ob08re2img01.jpg", "text": "", "time": "0", "id": 0}, {"image": "frn4le05ob08re2img01.jpg", "text": "<span class=\"strong notdialogue\">Carnet de voyage, le 7 juillet, Pampelune, Espagne</span>", "time": "45", "id": 1}, {"image": "frn4le05ob08re2img02.jpg", "text": "Je suis arriv\u00e9e \u00e0 Pampelune hier soir, et aujourd'hui j'ai d\u00e9cid\u00e9 d'explorer la ville. Je me promenais tranquillement dans les rues lorsque des centaines de personnes ont soudainement commenc\u00e9 \u00e0 remplir les rues.", "time": "4800", "id": 2}, {"image": "frn4le05ob08re2img02.jpg", "text": "Ils \u00e9taient tr\u00e8s agit\u00e9s et ils allaient dans tous les sens. Je voulais savoir o\u00f9 ils allaient, alors je les ai suivis.", "time": "16500", "id": 3}, {"image": "frn4le05ob08re2img03.jpg", "text": "Apr\u00e8s quelques minutes, nous sommes arriv\u00e9s \u00e0 une grande rue avec des barri\u00e8res de chaque c\u00f4t\u00e9. Les gens se tenaient derri\u00e8re les barri\u00e8res.  Tout \u00e0 coup, les gens ont cess\u00e9 de parler. Ils regardaient tous dans la m\u00eame direction.  Un groupe d'hommes courait tr\u00e8s vite, chass\u00e9 par un troupeau de taureaux ! Une personne s'est fait pi\u00e9tiner. Tout s'est termin\u00e9 tr\u00e8s rapidement. \u00c7a a \u00e9t\u00e9 vraiment une exp\u00e9rience incroyable !  Ce festival est certainement le temps fort de mon voyage jusqu'\u00e0 maintenant.", "time": "24200", "id": 4}, {"image": "frn4le05ob08re2img03.jpg", "text": "L'h\u00f4tel o\u00f9 je reste...", "time": "51500", "id": 5}]}}], "_data": []}, {"template_override": 1, "type": "audio", "id": 3, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "frn4le05ob08re3aud01", "coverimg": "frn4le05ob08re3img01.jpg", "images": [{"image": "frn4le05ob08re3img01.jpg", "text": "", "time": "0", "id": 0}, {"image": "frn4le05ob08re3img02.jpg", "text": "<ul><li>\u00c9crire un carnet de voyage</li></ul>", "time": "100", "id": 1}, {"image": "frn4le05ob08re3img03.jpg", "text": "", "time": "1750", "id": 2}, {"image": "frn4le05ob08re3img04.jpg", "text": "<ul><li>Ce qu'il faut inclure</li></ul>", "time": "9000", "id": 3}, {"image": "frn4le05ob08re3img05.jpg", "text": "", "time": "19500", "id": 4}, {"image": "frn4le05ob08re3img06.jpg", "text": "", "time": "27000", "id": 5}, {"image": "frn4le05ob08re3img07.jpg", "text": "", "time": "37000", "id": 6}, {"image": "frn4le05ob08re3img08.jpg", "text": "", "time": "48000", "id": 7}, {"image": "frn4le05ob08re3img01.jpg", "text": "", "time": "54000", "id": 8}]}}], "_data": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_con